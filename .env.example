# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=peoplepay360
PGUSER=postgres
PGPASSWORD=postgres
# Optional full connection URL (overrides separate PG* vars if set)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peoplepay360

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-peoplepay360-change-in-production
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# Pagination Defaults
PAGINATION_DEFAULT_PAGE_SIZE=20
PAGINATION_MAX_PAGE_SIZE=100
